<Window x:Class="MusicDownloaderPro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:MusicDownloaderPro.ViewModels" Title="MusicDownloader Pro" Width="1240" Height="780" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" Icon="Assets/MusicDownloaderPro.ico">
  <Window.DataContext><vm:MainViewModel/></Window.DataContext>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="#141720" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="6,10,6,24"><Image Source="Assets/logo.png" Width="42" Height="42"/><StackPanel Margin="10,0"><TextBlock Text="MusicDownloader" FontWeight="Bold" FontSize="16"/><TextBlock Text="PRO" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/></StackPanel></StackPanel><ItemsControl ItemsSource="{Binding Pages}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" HorizontalContentAlignment="Left" Background="Transparent" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="Downloads somente com autorização" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="8"/></DockPanel></Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="30">
      <StackPanel Visibility="{Binding CurrentPage,Converter={StaticResource pageVisibility},ConverterParameter=Início}"><TextBlock Text="MusicDownloader Pro" FontSize="34" FontWeight="Bold"/><TextBlock Text="Baixe e organize seus áudios autorizados em um só lugar." Foreground="{StaticResource SecondaryTextBrush}" FontSize="17" Margin="0,8,0,18"/><Border Style="{StaticResource Card}"><DockPanel><Button Content="🔍 Buscar" Command="{Binding SearchOnlineCommand}" DockPanel.Dock="Right" Padding="22,11"/><TextBox Text="{Binding OnlineQuery,UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="12" ToolTip="Buscar músicas na internet"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchOnlineCommand}"/></TextBox.InputBindings></TextBox></DockPanel></Border><UniformGrid Columns="4" Margin="0,18,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Downloads ativos"/><TextBlock Text="0" Style="{StaticResource Metric}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Downloads concluídos"/><TextBlock Text="{Binding DownloadItems.Count}" Style="{StaticResource Metric}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Espaço utilizado"/><TextBlock Text="Local" Style="{StaticResource Metric}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Músicas na biblioteca"/><TextBlock Text="{Binding Library.Count}" Style="{StaticResource Metric}"/></StackPanel></Border></UniformGrid><Button Content="+ Novo Download" Command="{Binding NavigateCommand}" CommandParameter="Novo Download" HorizontalAlignment="Left" Margin="4,28"/></StackPanel>
      <StackPanel Visibility="{Binding CurrentPage,Converter={StaticResource pageVisibility},ConverterParameter=Busca Online}"><TextBlock Text="Busca Online" Style="{StaticResource Heading}"/><Border Style="{StaticResource Warning}"><TextBlock Text="Resultados de fontes que oferecem download autorizado. O MusicDownloader Pro não contorna DRM ou proteções." TextWrapping="Wrap"/></Border><DockPanel Margin="0,14,0,12"><Button Content="🔍 Pesquisar" Command="{Binding SearchOnlineCommand}" DockPanel.Dock="Right"/><Button Content="Cancelar" Command="{Binding CancelCommand}" DockPanel.Dock="Right" Background="#34394A"/><TextBox Text="{Binding OnlineQuery,UpdateSourceTrigger=PropertyChanged}" FontSize="16" ToolTip="Buscar músicas na internet"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchOnlineCommand}"/></TextBox.InputBindings></TextBox></DockPanel><ProgressBar Height="6" IsIndeterminate="{Binding IsSearchingOnline}" Margin="0,0,0,12"/><ListView ItemsSource="{Binding OnlineResults}" SelectedItem="{Binding SelectedOnlineResult}" Height="420"><ListView.View><GridView><GridViewColumn Header="Música" DisplayMemberBinding="{Binding Title}" Width="260"/><GridViewColumn Header="Artista" DisplayMemberBinding="{Binding Artist}" Width="180"/><GridViewColumn Header="Álbum" DisplayMemberBinding="{Binding Album}" Width="160"/><GridViewColumn Header="Formato" DisplayMemberBinding="{Binding Formats}" Width="100"/><GridViewColumn Header="Fonte" DisplayMemberBinding="{Binding Provider}" Width="140"/><GridViewColumn Header="Licença" DisplayMemberBinding="{Binding License}" Width="230"/></GridView></ListView.View></ListView><StackPanel Orientation="Horizontal"><Button Content="⬇ Baixar selecionada" Command="{Binding DownloadOnlineResultCommand}"/><Button Content="Abrir na fonte" Command="{Binding OpenOnlineSourceCommand}" Background="#34394A"/></StackPanel></StackPanel>
      <StackPanel Visibility="{Binding CurrentPage,Converter={StaticResource pageVisibility},ConverterParameter=Novo Download}"><TextBlock Text="Novo Download" Style="{StaticResource Heading}"/><Border Style="{StaticResource Warning}"><TextBlock Text="Baixe somente conteúdos autorizados. Você é responsável por possuir permissão do titular ou da fonte." TextWrapping="Wrap"/></Border><TextBlock Text="Insira a URL do conteúdo autorizado para download" Margin="0,20,0,8"/><TextBox Text="{Binding Url,UpdateSourceTrigger=PropertyChanged}"/><StackPanel Orientation="Horizontal" Margin="0,12"><Button Content="Analisar" Command="{Binding AnalyzeCommand}"/><Button Content="Iniciar Download" Command="{Binding StartDownloadCommand}"/></StackPanel><Border Style="{StaticResource Card}" Visibility="{Binding AnalyzedAudio,Converter={StaticResource nullVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="110" Height="110" Background="#252A38" CornerRadius="12"><TextBlock Text="♫" FontSize="54" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding AnalyzedAudio.Name}" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding AnalyzedAudio.Artist,StringFormat=Artista: {0}}"/><TextBlock Text="{Binding AnalyzedAudio.Album,StringFormat=Álbum: {0}}"/><TextBlock Text="{Binding AnalyzedAudio.Format,StringFormat=Formato disponível: {0}}"/><TextBlock Text="{Binding AnalyzedAudio.Source,StringFormat=Fonte: {0}}"/></StackPanel></Grid></Border></StackPanel>
      <StackPanel Visibility="{Binding CurrentPage,Converter={StaticResource pageVisibility},ConverterParameter=Downloads}"><TextBlock Text="Downloads" Style="{StaticResource Heading}"/><ProgressBar Height="10" Value="{Binding CurrentProgress}" Maximum="100"/><ListView ItemsSource="{Binding DownloadItems}"><ListView.View><GridView><GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="270"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding StatusText}" Width="130"/><GridViewColumn Header="Progresso" DisplayMemberBinding="{Binding Progress,StringFormat={}{0:F0}%}" Width="100"/><GridViewColumn Header="Destino" DisplayMemberBinding="{Binding Destination}" Width="430"/></GridView></ListView.View></ListView><Button Content="Cancelar" Command="{Binding CancelCommand}" HorizontalAlignment="Left"/></StackPanel>
      <StackPanel Visibility="{Binding CurrentPage,Converter={StaticResource pageVisibility},ConverterParameter=Biblioteca}"><TextBlock Text="Biblioteca" Style="{StaticResource Heading}"/><StackPanel Orientation="Horizontal"><TextBox Width="360" Text="{Binding LibrarySearch,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Pesquisar" Command="{Binding RefreshLibraryCommand}"/><Button Content="Importar músicas" Command="{Binding ImportFilesCommand}"/></StackPanel><ListView ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedTrack}" Height="430"><ListView.View><GridView><GridViewColumn Header="Título" DisplayMemberBinding="{Binding Title}" Width="260"/><GridViewColumn Header="Artista" DisplayMemberBinding="{Binding Artist}" Width="180"/><GridViewColumn Header="Álbum" DisplayMemberBinding="{Binding Album}" Width="180"/><GridViewColumn Header="Favorito" DisplayMemberBinding="{Binding IsFavorite}" Width="80"/><GridViewColumn Header="Arquivo" DisplayMemberBinding="{Binding Path}" Width="330"/></GridView></ListView.View></ListView><StackPanel Orientation="Horizontal"><Button Content="▶ Reproduzir" Command="{Binding PlayCommand}"/><Button Content="⏸ Pausar" Command="{Binding PauseCommand}"/><Button Content="★ Favorito" Command="{Binding ToggleFavoriteCommand}"/><Button Content="Abrir pasta" Command="{Binding OpenFolderCommand}"/></StackPanel></StackPanel>
      <StackPanel Visibility="{Binding CurrentPage,Converter={StaticResource pageVisibility},ConverterParameter=Conversor}"><TextBlock Text="Conversor" Style="{StaticResource Heading}"/><Border Style="{StaticResource Warning}"><TextBlock Text="Use o conversor somente em arquivos que você possui legalmente. O aplicativo não remove DRM." TextWrapping="Wrap"/></Border><TextBlock Text="Arquivo de entrada" Margin="0,18,0,6"/><DockPanel><Button Content="Selecionar arquivo" Command="{Binding SelectConversionInputCommand}" DockPanel.Dock="Right"/><TextBox Text="{Binding ConversionInput}"/></DockPanel><TextBlock Text="Formato de saída" Margin="0,18,0,6"/><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding ConversionFormat}" Width="180" HorizontalAlignment="Left"/><Button Content="Converter" Command="{Binding ConvertCommand}" HorizontalAlignment="Left" Margin="0,18"/><ProgressBar Height="10" Value="{Binding CurrentProgress}"/></StackPanel>
      <StackPanel Visibility="{Binding CurrentPage,Converter={StaticResource pageVisibility},ConverterParameter=Histórico}"><TextBlock Text="Histórico" Style="{StaticResource Heading}"/><TextBlock Text="Os downloads e as conversões concluídas ficam registrados localmente no banco SQLite." Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
      <StackPanel Visibility="{Binding CurrentPage,Converter={StaticResource pageVisibility},ConverterParameter=Favoritos}"><TextBlock Text="Favoritos" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding Library}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><TextBlock Text="{Binding Title}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      <StackPanel Visibility="{Binding CurrentPage,Converter={StaticResource pageVisibility},ConverterParameter=Configurações}"><TextBlock Text="Configurações" Style="{StaticResource Heading}"/><TextBlock Text="Pasta padrão"/><TextBox Text="{Binding Settings.DownloadFolder}" Margin="0,6,0,14"/><TextBlock Text="Máximo de downloads simultâneos (1–10)"/><TextBox Text="{Binding Settings.MaxSimultaneousDownloads}" Width="100" HorizontalAlignment="Left" Margin="0,6,0,14"/><TextBlock Text="Caminho do FFmpeg (opcional)"/><TextBox Text="{Binding Settings.FfmpegPath}" Margin="0,6,0,14"/><CheckBox Content="Perguntar antes de substituir arquivos" IsChecked="{Binding Settings.AskBeforeReplace}" Foreground="White"/><CheckBox Content="Criar subpastas automaticamente" IsChecked="{Binding Settings.CreateSubfolders}" Foreground="White"/><CheckBox Content="Notificar quando concluir" IsChecked="{Binding Settings.NotifyCompleted}" Foreground="White"/><Button Content="Salvar configurações" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,18"/></StackPanel>
      <StackPanel Visibility="{Binding CurrentPage,Converter={StaticResource pageVisibility},ConverterParameter=Sobre}"><Image Source="Assets/logo.png" Width="130" Height="130" HorizontalAlignment="Left"/><TextBlock Text="MusicDownloader Pro" Style="{StaticResource Heading}"/><TextBlock Text="Versão 1.0.0 — © 2026 Mateus Oliveira"/><TextBlock Text="Gerenciador de downloads de áudio autorizados, biblioteca musical local, player e conversor." TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Não oferece mecanismos para contornar DRM, paywalls, autenticação ou limitações de plataformas." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
    </Grid></ScrollViewer>
    <Border Grid.Column="1" Grid.Row="1" Background="#181B24" Padding="16,10"><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}"/></Border>
  </Grid>
</Window>
